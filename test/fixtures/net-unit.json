 "images_tree": {
  "feedback.md": "# Feedback log\n\nClaude learns from this file. The web app appends ratings automatically; you can edit by hand.\n\n## Ratings\n\n| Week | Dish | Score | Comment |\n|---|---|---|---|\n\n## Blocked — never suggest again\n\n## Rules\n\n## What worked\n",
  "household.toml": "# Meal Prep Studio — household configuration.\n# Everything personal lives in this folder; the tool itself stays generic.\nname = \"Meal Prep Studio\"\nlanguage = \"en\"            # \"en\" or \"de\" (UI + everything Claude writes)\n\n# Never suggested — checked in titles and ingredients (\"without X\" is fine).\nexclusions = [\"mushroom\"]\n\n[schedule]\ndays = 4                   # eating days per prep round\n# freeze_days = 2           # optional: freeze the last N days on prep day\nshopping_day = \"sat\"\nprep_day = \"sun\"\nfirst_day = \"mon\"\n\n[budget]\nper_round = 60\ncurrency = \"€\"\n\n# One entry per person. kcal = daily target, protein in g/day.\n[[persons]]\nid = \"a\"\nlabel = \"Alex\"\nname = \"Alex\"\nkcal = 2200\nprotein = 150\n\n[[persons]]\nid = \"b\"\nlabel = \"Sam\"\nname = \"Sam\"\nkcal = 1800\nprotein = 120\n\n# Meals that are NOT planned (fixed breakfast, shake …) — subtracted from the daily target.\n[[fixed_meals]]\nname = \"Breakfast\"\ntext = \"Oats with yogurt and berries\"\nkcal = 450\nprotein = 25\ncarbs = 55\n\n# Meals Claude plans. Either `share` of what is left after fixed meals,\n# or exact `targets = { a = 700, b = 560 }` per person.\n[[meals]]\nid = \"lunch\"\nlabel = \"Lunch · cold\"\ncold = true\nshare = 0.42\n\n[[meals]]\nid = \"dinner\"\nlabel = \"Dinner · warm\"\nshare = 0.58\n\n# Supermarket offers (Germany/Austria via marktguru). Set enabled = false elsewhere.\n[offers]\nenabled = false\nzip = \"\"\nretailers = [\"aldi-sued\", \"lidl\", \"netto-marken-discount\", \"kaufland\", \"rewe\", \"edeka\"]\nmarkup = { rewe = 1.15, edeka = 1.15 }   # regular-price surcharge vs. discounters\nsecond_store_min_saving = 3.0            # only suggest a second store if it saves this much\n\n[agent]\ncommand = \"claude\"         # Claude Code CLI, logged in\nmodel = \"sonnet\"           # sonnet = fast & good; opus = slower, more careful\ncandidates_per_meal = 4\n\n[server]\nport = 8090\npin = \"\"                   # set a PIN if other people use your Wi-Fi\n",
